# Groq Cloud LLM
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Exa.ai Neural Search API (Triggered if LLM confidence < 90% or library is newer than cutoff)
EXA_API_KEY=your_exa_api_key_here

# GitHub MCP Integration (for searching issues & 1-click issue filing)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_org/your_repo

# Slack MCP Integration (for 1-click sharing diagnosis & terminal fixes to channels)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
